(* ======================================================================
   Ascon-MAVLink -- per-mission session-key establishment (handshake.c)
   ProVerif model (Dolev-Yao attacker on the public channel c)

     G -> V : N_G, E_G, Sign(sk_G, (N_G, E_G))
     V -> G : N_V, E_V, Sign(sk_V, TH)       TH = (N_G, E_G, N_V, E_V)
     both   : ss = DH(E_peer, e_own)
              K_up || K_down || SID = Ascon-XOF128(ss || TH)
     G -> V : first uplink AEAD frame under K_up   (key confirmation)
     V -> G : first downlink AEAD frame under K_down

   Run:  proverif ascon_mavlink_handshake.pv | grep RESULT
   ====================================================================== *)

free c: channel.

type skey.
type pkey.
type key.
type nonce.
type exponent.
type G.

(* ---------- Ed25519 signatures ---------- *)
fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
fun verify(bitstring, bitstring, pkey): bool
  reduc forall m: bitstring, k: skey; verify(sign(m, k), m, pk(k)) = true.

(* ---------- X25519 Diffie-Hellman ---------- *)
const g: G [data].
fun exp(G, exponent): G.
equation forall x: exponent, y: exponent; exp(exp(g, x), y) = exp(exp(g, y), x).

(* ---------- Ascon-XOF128 key derivation: two independent outputs ---------- *)
fun kup(G, bitstring): key.
fun kdown(G, bitstring): key.

(* ---------- Ascon-AEAD128: (plaintext, key, nonce, associated data) ---------- *)
fun aenc(bitstring, key, bitstring, bitstring): bitstring.
fun adec(bitstring, key, bitstring, bitstring): bitstring
  reduc forall m: bitstring, k: key, n: bitstring, ad: bitstring;
        adec(aenc(m, k, n, ad), k, n, ad) = m.

free hdr: bitstring.                       (* cleartext MAVLink header = AD *)
free payloadUp: bitstring [private].       (* uplink MAVLink payload       *)
free payloadDown: bitstring [private].     (* downlink MAVLink payload     *)

(* ---------- events ---------- *)
event GroundStart(pkey, pkey, nonce, G).
event GroundAccept(pkey, pkey, nonce, G, nonce, G).
event VehicleAccept(pkey, pkey, nonce, G, nonce, G).
event VehicleConfirm(pkey, pkey, nonce, G, nonce, G).
event GroundConfirm(pkey, pkey, nonce, G, nonce, G).

(* ---------- security properties ---------- *)

(* Q1-Q2  Confidentiality of protected traffic, including after the
          long-term identity keys leak in phase 1 (forward secrecy). *)
query attacker(payloadUp).
query attacker(payloadDown).

(* Q3  Vehicle authenticated to ground: every ground session that accepts
       matches a distinct vehicle session with the same transcript. *)
query a: pkey, b: pkey, x: nonce, gx: G, y: nonce, gy: G;
  inj-event(GroundAccept(a, b, x, gx, y, gy)) ==> inj-event(VehicleAccept(a, b, x, gx, y, gy)).

(* Q4  Ground authenticated to vehicle at handshake level (non-injective):
       M1 always originates from the genuine ground side. *)
query a: pkey, b: pkey, x: nonce, gx: G, y: nonce, gy: G;
  event(VehicleAccept(a, b, x, gx, y, gy)) ==> event(GroundStart(a, b, x, gx)).

(* Q5  Same, injective. EXPECTED TO FAIL: M1 is not bound to a
       vehicle-chosen value, so a recorded M1 can be replayed. *)
query a: pkey, b: pkey, x: nonce, gx: G, y: nonce, gy: G;
  inj-event(VehicleAccept(a, b, x, gx, y, gy)) ==> inj-event(GroundStart(a, b, x, gx)).

(* Q6  Key confirmation: once the vehicle has verified the first uplink
       frame, a distinct ground session holds the same transcript. *)
query a: pkey, b: pkey, x: nonce, gx: G, y: nonce, gy: G;
  inj-event(VehicleConfirm(a, b, x, gx, y, gy)) ==> inj-event(GroundAccept(a, b, x, gx, y, gy)).

(* Q7  Same for the ground side; also shows that an uplink frame cannot be
       reflected back to the ground side (directional keys). *)
query a: pkey, b: pkey, x: nonce, gx: G, y: nonce, gy: G;
  inj-event(GroundConfirm(a, b, x, gx, y, gy)) ==> inj-event(VehicleConfirm(a, b, x, gx, y, gy)).

(* ---------- roles ---------- *)
let Ground(skG: skey, pkV: pkey) =
  new eG: exponent;
  new nG: nonce;
  let EG = exp(g, eG) in
  event GroundStart(pk(skG), pkV, nG, EG);
  out(c, (nG, EG, sign((nG, EG), skG)));
  in(c, (nV: nonce, EV: G, sV: bitstring));
  let TH = (nG, EG, nV, EV) in
  if verify(sV, TH, pkV) = true then
  let ss = exp(EV, eG) in
  let ku = kup(ss, TH) in
  let kd = kdown(ss, TH) in
  event GroundAccept(pk(skG), pkV, nG, EG, nV, EV);
  new ctrU: bitstring;
  out(c, (ctrU, aenc(payloadUp, ku, ctrU, hdr)));
  in(c, (ctrD: bitstring, ctD: bitstring));
  let mD = adec(ctD, kd, ctrD, hdr) in
  event GroundConfirm(pk(skG), pkV, nG, EG, nV, EV).

let Vehicle(skV: skey, pkG: pkey) =
  in(c, (nG: nonce, EG: G, sG: bitstring));
  if verify(sG, (nG, EG), pkG) = true then
  new eV: exponent;
  new nV: nonce;
  let EV = exp(g, eV) in
  let TH = (nG, EG, nV, EV) in
  event VehicleAccept(pkG, pk(skV), nG, EG, nV, EV);
  out(c, (nV, EV, sign(TH, skV)));
  let ss = exp(EG, eV) in
  let ku = kup(ss, TH) in
  let kd = kdown(ss, TH) in
  in(c, (ctrU: bitstring, ctU: bitstring));
  let mU = adec(ctU, ku, ctrU, hdr) in
  event VehicleConfirm(pkG, pk(skV), nG, EG, nV, EV);
  new ctrD: bitstring;
  out(c, (ctrD, aenc(payloadDown, kd, ctrD, hdr))).

(* ---------- system: unbounded sessions, then key compromise ---------- *)
process
  new skG: skey;
  new skV: skey;
  out(c, pk(skG));
  out(c, pk(skV));
  (
      (! Ground(skG, pk(skV)))
    | (! Vehicle(skV, pk(skG)))
    | (phase 1; out(c, (skG, skV)))      (* long-term keys leak after the missions *)
  )
